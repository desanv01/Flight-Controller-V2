# FCV2 FC Rev A bootloader — ArduPilot Copter-4.7.1
MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_FCV2

# ASE-8.000MHZ-L-C-T is an active 3.3 V CMOS oscillator driving OSC_IN.
OSCILLATOR_HZ 8000000
define STM32_HSE_BYPASS

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# USB-C is data/loading only. BOARD_OTG_NOVBUSSENS permits externally powered boot.
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
define BOARD_OTG_NOVBUSSENS 1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PB0 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

# Hold all SPI devices deselected during boot.
PA4 FLASH_CS CS
PD3 BMI270_CS CS
PD7 ICM42688_CS CS
PC13 OSD_CS CS

define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1
