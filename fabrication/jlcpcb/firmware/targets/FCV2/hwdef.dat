# FCV2 FC Rev A — ArduPilot Copter-4.7.1 production target
# MCU: STM32H743VIT6. APJ numeric mapping is temporary/local until upstream reserves it.

MCU STM32H7xx STM32H743xx
APJ_BOARD_ID AP_HW_FCV2

# ASE-8.000MHZ-L-C-T is an active 3.3 V CMOS oscillator driving OSC_IN.
OSCILLATOR_HZ 8000000
define STM32_HSE_BYPASS

env USE_ALT_RAM_MAP 1
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16
define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

# USB-C is data/debug only; VBUS is intentionally not connected to +5V.
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
define BOARD_OTG_NOVBUSSENS 1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

PB0 LED0 OUTPUT LOW GPIO(90)
PC5 LED1 OUTPUT LOW GPIO(91)
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 91
define HAL_LED_ON 0

SERIAL_ORDER OTG1 USART2 USART3 UART4 UART5 UART7 UART8 USART1
PA2 USART2_TX USART2
PA3 USART2_RX USART2
PD8 USART3_TX USART3
PD9 USART3_RX USART3
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN
PA0 UART4_TX UART4
PA1 UART4_RX UART4
PB13 UART5_TX UART5 NODMA
PB12 UART5_RX UART5 NODMA
PE8 UART7_TX UART7
PE7 UART7_RX UART7
PE1 UART8_TX UART8 NODMA
PE0 UART8_RX UART8 NODMA
PB14 USART1_TX USART1 NODMA
PB15 USART1_RX USART1 NODMA

# SPI1: flash, SPI3: BMI270, SPI4: MAX7456, SPI6: ICM42688P.
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC10 SPI3_SCK SPI3
PC11 SPI3_MISO SPI3
PC12 SPI3_MOSI SPI3
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PB3 SPI6_SCK SPI6
PB4 SPI6_MISO SPI6
PB5 SPI6_MOSI SPI6

PA4 FLASH_CS CS
PD3 BMI270_CS CS
PC13 OSD_CS CS
PD7 ICM42688_CS CS
PD2 BMI270_DRDY INPUT
PE4 ICM42688_DRDY INPUT

I2C_ORDER I2C2 I2C4
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
PB6 I2C4_SCL I2C4
PB7 I2C4_SDA I2C4

SPIDEV bmi270 SPI3 DEVID1 BMI270_CS MODE3 1*MHZ 10*MHZ
SPIDEV osd SPI4 DEVID4 OSD_CS MODE0 10*MHZ 10*MHZ
SPIDEV dataflash SPI1 DEVID1 FLASH_CS MODE3 1*MHZ 50*MHZ
SPIDEV icm42688p SPI6 DEVID1 ICM42688_CS MODE3 2*MHZ 8*MHZ

# Keep TIM1 motor DMA exclusive and prioritize both IMU buses. On STM32H743,
# Copter-4.7.1 resolves SPI6 to its proven non-DMA HAL path (as used by existing
# H743 hwdefs), avoiding inaccessible BDMA buffers while retaining the primary IMU.
DMA_NOSHARE TIM1* SPI6* SPI3*
DMA_PRIORITY TIM1* SPI6* SPI3* SPI1*

IMU Invensensev3 SPI:icm42688p ROTATION_NONE
IMU BMI270 SPI:bmi270 ROTATION_NONE
define HAL_DEFAULT_INS_FAST_SAMPLE 3
BARO BMP388 I2C:0:0x76

define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# Analog OSD remains compiled but is disabled by the supplied defaults.
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 0
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

# PC1 has no qualified flight-battery source and PC3 is not a current sensor.
PC1 ANALOG_SPARE ADC1 SCALE(1)
define HAL_BATT_MONITOR_DEFAULT 0

# J6 pins 5..8. ArduPilot Quad-X physical motor geometry:
# output 1 / PE14 / front-right / CCW
# output 2 / PE13 / rear-left   / CCW
# output 3 / PE11 / front-left  / CW
# output 4 / PE9  / rear-right  / CW
PE14 TIM1_CH4 TIM1 PWM(1) GPIO(50) BIDIR
PE13 TIM1_CH3 TIM1 PWM(2) GPIO(51) BIDIR
PE11 TIM1_CH2 TIM1 PWM(3) GPIO(52) BIDIR
PE9 TIM1_CH1 TIM1 PWM(4) GPIO(53) BIDIR

PC6 TIM8_CH1 TIM8 PWM(5) GPIO(54)
PC7 TIM8_CH2 TIM8 PWM(6) GPIO(55)
PC8 TIM8_CH3 TIM8 PWM(7) GPIO(56)
PC9 TIM8_CH4 TIM8 PWM(8) GPIO(57)
PD12 TIM4_CH1 TIM4 PWM(9) GPIO(58)
PD13 TIM4_CH2 TIM4 PWM(10) GPIO(59)
PD14 TIM4_CH3 TIM4 PWM(11) GPIO(60)
PD15 TIM4_CH4 TIM4 PWM(12) GPIO(61)

define HAL_HAVE_SAFETY_SWITCH 0
define HAL_LOGGING_DATAFLASH_ENABLED 1
